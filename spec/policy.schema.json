{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SmartWatch policy (smartwatch.policy/v1)",
  "description": "spec/SEMANTICS.md section 3. JSON Schema cannot express every rule: levels must have unique names and strictly increasing thresholds, reset.level must be one of the level names, and hash_seed is limited to 256 UTF-8 bytes. sf-smartwatch validate checks all of them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "environment",
    "window_ms",
    "late_windows",
    "max_empty_windows",
    "min_agents",
    "levels",
    "hysteresis_permille",
    "reset",
    "limits",
    "hash_seed"
  ],
  "properties": {
    "schema": {
      "const": "smartwatch.policy/v1"
    },
    "environment": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:@/-]{1,128}$"
    },
    "window_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 60000
    },
    "late_windows": {
      "type": "integer",
      "minimum": 0,
      "maximum": 60
    },
    "max_empty_windows": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3600
    },
    "min_agents": {
      "type": "integer",
      "minimum": 2,
      "maximum": 1000000
    },
    "hysteresis_permille": {
      "type": "integer",
      "minimum": 0,
      "maximum": 900
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "min_density_micro"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,31}$",
            "not": {
              "const": "normal"
            }
          },
          "min_density_micro": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        }
      }
    },
    "reset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "sustain_ms",
        "mode",
        "confirm_timeout_ms",
        "on_timeout",
        "cooldown_ms",
        "max_agents",
        "hot_pair_min_count"
      ],
      "properties": {
        "level": {
          "type": "string"
        },
        "sustain_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "mode": {
          "enum": [
            "auto",
            "confirm",
            "off"
          ]
        },
        "confirm_timeout_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "on_timeout": {
          "enum": [
            "reset",
            "cancel"
          ]
        },
        "cooldown_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        },
        "max_agents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "hot_pair_min_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_pairs_exact",
        "max_agents_exact",
        "top_k",
        "candidates"
      ],
      "properties": {
        "max_pairs_exact": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "max_agents_exact": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "top_k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "candidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        }
      }
    },
    "hash_seed": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  }
}
