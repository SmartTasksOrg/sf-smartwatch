# Copy to deploy/.env and replace every value. Never commit deploy/.env.
# Long random values: python -c "import secrets; print(secrets.token_urlsafe(32))"
SMARTWATCH_INGEST_TOKEN=replace-with-a-long-random-value
SMARTWATCH_OPERATOR_TOKEN=replace-with-another-long-random-value
# Who may reset and decide: an HS256 secret of at least 32 bytes (or mount a public key and set
# SMARTWATCH_JWT_PUBLIC_KEY in docker-compose.yml)
SMARTWATCH_JWT_HS256_SECRET=
SMARTWATCH_JWT_ISSUER=
SMARTWATCH_JWT_AUDIENCE=
SMARTWATCH_OPERATOR_ALLOW=
SMARTWATCH_ALERT_WEBHOOK=
SMARTWATCH_RESET_WEBHOOK=
SMARTWATCH_ESCALATION_WEBHOOK=
SMARTWATCH_WEBHOOK_SECRET=
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-value
